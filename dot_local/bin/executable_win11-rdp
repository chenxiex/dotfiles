#!/usr/bin/env bash

set -Eeuo pipefail

readonly LIBVIRT_URI="qemu:///system"
readonly RDP_PORT="3389"
readonly PING_INTERVAL=2
readonly CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/rdp/win11-rdp.conf"

RDP_USERNAME=''
RDP_DOMAIN=''
RDP_PASSWORD=''
RDP_CERT_SHA256=''
VM_NAME=''
VM_IP=''
NOTIFY_ENABLED=1

if [[ -r "$CONFIG_FILE" ]]; then
    # 配置文件由当前用户控制，其中的值按 shell 语法读取。
    # shellcheck source=/dev/null
    source "$CONFIG_FILE"
else
    printf '错误：无法读取配置文件 %s。\n' "$CONFIG_FILE" >&2
    exit 1
fi

if [[ -z "$VM_NAME" || -z "$VM_IP" ]]; then
    printf '错误：配置文件中的 VM_NAME 和 VM_IP 均不能为空。\n' >&2
    exit 1
fi

if [[ ! "$RDP_CERT_SHA256" =~ ^[[:xdigit:]]{64}$ ]]; then
    printf '错误：配置文件中的 RDP_CERT_SHA256 必须是 64 位十六进制 SHA-256 指纹。\n' >&2
    exit 1
fi

virsh_c() {
    LC_ALL=C virsh "$@"
}

notify_status() {
    [[ "$NOTIFY_ENABLED" == 1 ]] || return 0

    if ! command -v notify-send >/dev/null 2>&1; then
        printf '警告：找不到 notify-send，跳过桌面通知。\n' >&2
        NOTIFY_ENABLED=0
        return 0
    fi

    local notify_error
    if ! notify_error="$(notify-send \
        --app-name="Windows 11 远程桌面" \
        --icon=computer \
        --urgency=normal \
        --expire-time=8000 \
        "Windows 11 远程桌面" "$1" 2>&1)"; then
        printf '警告：桌面通知发送失败：%s\n' "${notify_error:-未知错误}" >&2
        printf '警告：本次运行将跳过后续桌面通知。\n' >&2
        NOTIFY_ENABLED=0
    fi
}

log() {
    printf '[%(%H:%M:%S)T] %s\n' -1 "$1"
}

notify_status "正在启动 ${VM_NAME}，随后将等待 ${VM_IP} 就绪……"

for command_name in virsh ping sdl-freerdp3; do
    if ! command -v "$command_name" >/dev/null 2>&1; then
        printf '错误：找不到命令 %s。\n' "$command_name" >&2
        exit 127
    fi
done

log "正在检查虚拟机 ${VM_NAME} 的状态……"

if ! vm_state="$(virsh_c --connect "$LIBVIRT_URI" domstate "$VM_NAME" 2>/dev/null)"; then
    printf '错误：无法在 %s 中找到或查询虚拟机 %s。\n' "$LIBVIRT_URI" "$VM_NAME" >&2
    exit 1
fi

case "$vm_state" in
    "shut off"|"crashed")
        log "虚拟机 ${VM_NAME} 当前为 ${vm_state}，正在启动……"
        virsh_c --connect "$LIBVIRT_URI" start "$VM_NAME"
        ;;
    running|idle)
        log "虚拟机 ${VM_NAME} 已启动。"
        ;;
    paused|pmsuspended)
        log "虚拟机 ${VM_NAME} 当前为 ${vm_state}，正在恢复……"
        virsh_c --connect "$LIBVIRT_URI" resume "$VM_NAME"
        ;;
    *)
        log "虚拟机 ${VM_NAME} 当前状态为 ${vm_state}，继续监控……"
        ;;
esac

log "等待 ${VM_IP} 响应 ping（按 Ctrl+C 取消）……"
last_wait_state=''
ping_attempts=0

while true; do
    if ! wait_state="$(virsh_c --connect "$LIBVIRT_URI" domstate "$VM_NAME" 2>/dev/null)"; then
        log "无法查询虚拟机 ${VM_NAME} 的状态，稍后重试……"
        sleep "$PING_INTERVAL"
        continue
    fi

    if [[ "$wait_state" != "$last_wait_state" ]]; then
        case "$wait_state" in
            "shut off"|"crashed")
                log "检测到虚拟机 ${VM_NAME} 已关闭，正在重新启动……"
                virsh_c --connect "$LIBVIRT_URI" start "$VM_NAME"
                ;;
            paused|pmsuspended)
                log "检测到虚拟机 ${VM_NAME} 已暂停，正在恢复……"
                virsh_c --connect "$LIBVIRT_URI" resume "$VM_NAME"
                ;;
            running|idle)
                log "虚拟机 ${VM_NAME} 正在运行，等待 ${VM_IP} 响应 ping……"
                ;;
            *)
                log "虚拟机 ${VM_NAME} 当前为 ${wait_state}，继续等待……"
                ;;
        esac
        last_wait_state="$wait_state"
    fi

    if [[ "$wait_state" == "running" || "$wait_state" == "idle" ]]; then
        if ping -n -c 1 -W 1 "$VM_IP" >/dev/null 2>&1; then
            break
        fi

        ((ping_attempts += 1))
        if (( ping_attempts % 10 == 0 )); then
            log "仍在等待 ${VM_IP} 响应 ping，已探测 ${ping_attempts} 次……"
        fi
    fi

    sleep "$PING_INTERVAL"
done

log "虚拟机已就绪，正在通过 FreeRDP SDL 连接……"
rdp_args=(
    "/v:${VM_IP}:${RDP_PORT}"
    "/cert:fingerprint:sha256:${RDP_CERT_SHA256}"
)

[[ -n "$RDP_USERNAME" ]] && rdp_args+=("/u:${RDP_USERNAME}")
[[ -n "$RDP_DOMAIN" ]] && rdp_args+=("/d:${RDP_DOMAIN}")
[[ -n "$RDP_PASSWORD" ]] && rdp_args+=("/p:${RDP_PASSWORD}")

exec sdl-freerdp3 "${rdp_args[@]}" "$@"
