#!/bin/bash
export PODMAN_USERNS=keep-id

# 判断 Podman 服务端是否有可用的 NVIDIA GPU
has_gpu() {
    local devices

    # Podman 6+ 会在 info 中报告服务端已解析的 CDI 设备。
    if devices="$(podman-remote info --format \
        '{{range .Host.DiscoveredDevices}}{{println .Source .ID}}{{end}}' 2>/dev/null)"; then
        while read -r source id _; do
            if [[ "$source" == "cdi" && "$id" == nvidia.com/gpu=* ]]; then
                return 0
            fi
        done <<< "$devices"

        return 1
    fi

    # 旧版 Podman 没有 DiscoveredDevices 字段，通过实际的 CDI 容器验证回退。
    podman-remote run --rm \
        --device nvidia.com/gpu=all \
        --security-opt=label=disable \
        ubuntu nvidia-smi -L >/dev/null 2>&1
}

# 拦截 docker info
if [[ "$1" == "info" ]]; then
    if [[ "$2" == "-f" ]]; then
        TEMPLATE="$3"

        # devcontainer 的关键检测点
        if [[ "$TEMPLATE" == *".Runtimes.nvidia"* ]]; then
            if has_gpu; then
                echo "map[path:nvidia-container-runtime runtimeArgs:[]]"
            else
                echo "<no value>"
            fi
            exit 0
        fi
    fi
fi

if [[ "$1" == "run" ]]; then
    shift
    exec podman-remote run --tmpfs=/tmp:rw,exec,nosuid,nodev,mode=1777 "$@"
fi

exec podman-remote "$@"
