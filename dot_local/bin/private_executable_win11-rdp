#!/usr/bin/env bash

set -Eeuo pipefail

readonly LIBVIRT_URI="qemu:///system"
readonly RDP_PORT="3389"
readonly PING_INTERVAL=2
readonly CONFIG_FILE="${XDG_CONFIG_HOME}/rdp/win11-rdp.conf"

export LC_ALL=C

RDP_USERNAME=''
RDP_DOMAIN=''
RDP_PASSWORD=''
RDP_CERT_SHA256=''
VM_NAME=''
VM_IP=''

if [[ -r "$CONFIG_FILE" ]]; then
    # 配置文件由当前用户控制，其中的值按 shell 语法读取。
    # shellcheck source=/dev/null
    source "$CONFIG_FILE"
else
    printf '错误：无法读取配置文件 %s。\n' "$CONFIG_FILE" >&2
    exit 1
fi

if [[ -z "$VM_NAME" || -z "$VM_IP" ]]; then
    printf '错误：配置文件中的 VM_NAME 和 VM_IP 均不能为空。\n' >&2
    exit 1
fi

if [[ ! "$RDP_CERT_SHA256" =~ ^[[:xdigit:]]{64}$ ]]; then
    printf '错误：配置文件中的 RDP_CERT_SHA256 必须是 64 位十六进制 SHA-256 指纹。\n' >&2
    exit 1
fi

log() {
    printf '[%(%H:%M:%S)T] %s\n' -1 "$*"
}

for command_name in virsh ping sdl-freerdp3; do
    if ! command -v "$command_name" >/dev/null 2>&1; then
        printf '错误：找不到命令 %s。\n' "$command_name" >&2
        exit 127
    fi
done

if ! vm_state="$(virsh --connect "$LIBVIRT_URI" domstate "$VM_NAME" 2>/dev/null)"; then
    printf '错误：无法在 %s 中找到或查询虚拟机 %s。\n' "$LIBVIRT_URI" "$VM_NAME" >&2
    exit 1
fi

case "$vm_state" in
    "shut off"|"crashed")
        log "虚拟机 ${VM_NAME} 当前为 ${vm_state}，正在启动……"
        virsh --connect "$LIBVIRT_URI" start "$VM_NAME"
        ;;
    running|idle)
        log "虚拟机 ${VM_NAME} 已启动。"
        ;;
    paused|pmsuspended)
        log "虚拟机 ${VM_NAME} 当前为 ${vm_state}，正在恢复……"
        virsh --connect "$LIBVIRT_URI" resume "$VM_NAME"
        ;;
    *)
        log "虚拟机 ${VM_NAME} 当前状态为 ${vm_state}，等待其运行……"
        while [[ "$(virsh --connect "$LIBVIRT_URI" domstate "$VM_NAME" 2>/dev/null || true)" != "running" ]]; do
            sleep 1
        done
        ;;
esac

log "等待 ${VM_IP} 响应 ping（按 Ctrl+C 取消）……"
until ping -n -c 1 -W 1 "$VM_IP" >/dev/null 2>&1; do
    sleep "$PING_INTERVAL"
done

log "虚拟机已就绪，正在通过 FreeRDP SDL 连接……"
rdp_args=(
    "/v:${VM_IP}:${RDP_PORT}"
    "/cert:fingerprint:sha256:${RDP_CERT_SHA256}"
)

[[ -n "$RDP_USERNAME" ]] && rdp_args+=("/u:${RDP_USERNAME}")
[[ -n "$RDP_DOMAIN" ]] && rdp_args+=("/d:${RDP_DOMAIN}")
[[ -n "$RDP_PASSWORD" ]] && rdp_args+=("/p:${RDP_PASSWORD}")

exec sdl-freerdp3 "${rdp_args[@]}" "$@"
