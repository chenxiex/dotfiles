#!/bin/bash
set -e

CODEX_PATH="$HOME/.config/codex"
INSTALL_PATHS=(
  "$HOME/.codex"
)

merge_config() {
  local source="$CODEX_PATH/config.toml"
  local target="$1/config.toml"

  [ -f "$source" ] || return 0
  if ! command -v python3 >/dev/null 2>&1; then
    printf 'Warning: python3 not found; skipping merge of %s into %s\n' "$source" "$target" >&2
    return 0
  fi

  python3 - "$source" "$target" <<'PY'
import importlib
import os
import sys
import tempfile
from collections.abc import MutableMapping
from pathlib import Path

source_path, target_path = map(Path, sys.argv[1:])
for reader_name, writer_name in (
    ("tomlkit", "tomlkit"),
    ("toml", "toml"),
    ("tomllib", "tomli_w"),
    ("tomli", "tomli_w"),
):
    try:
        reader = importlib.import_module(reader_name)
        writer = importlib.import_module(writer_name)
    except ImportError:
        continue
    break
else:
    print(
        f"Warning: no TOML parser/writer found (tomlkit, toml, or tomllib/tomli + tomli_w); "
        f"skipping merge of {source_path} into {target_path}",
        file=sys.stderr,
    )
    sys.exit(0)


def merge(target, source):
    if isinstance(target, MutableMapping) and isinstance(source, MutableMapping):
        for key, value in source.items():
            target[key] = merge(target[key], value) if key in target else value
        return target
    return source


source = reader.loads(source_path.read_text(encoding="utf-8"))
target_text = target_path.read_text(encoding="utf-8") if target_path.exists() else ""
target = reader.loads(target_text)
merged = writer.dumps(merge(target, source))

# Replace the target atomically, including a link left by earlier script versions.
temporary_path = None
try:
    with tempfile.NamedTemporaryFile(
        mode="w", encoding="utf-8", dir=target_path.parent,
        prefix=target_path.name + ".", delete=False,
    ) as temporary:
        temporary_path = Path(temporary.name)
        os.chmod(temporary_path, 0o600)
        temporary.write(merged)
    os.replace(temporary_path, target_path)
finally:
    if temporary_path is not None and temporary_path.exists():
        temporary_path.unlink()
PY
}

relative_path() {
  perl -MCwd=abs_path -MFile::Basename=dirname,basename -MFile::Spec -e '
    my ($target, $base) = @ARGV;
    my $target_dir = abs_path(dirname($target)) // die "cannot resolve target dir: $target\n";
    my $base_dir = abs_path($base) // die "cannot resolve base dir: $base\n";
    print File::Spec->abs2rel(File::Spec->catfile($target_dir, basename($target)), $base_dir);
  ' "$1" "$2"
}

ensure_directory() {
  local source_dir="$1"
  local target_dir="$2"

  if [ -L "$target_dir" ]; then
    if [ "$target_dir" -ef "$source_dir" ]; then
      unlink "$target_dir"
    fi
  fi
  mkdir -p "$target_dir"
}

for install_path in "${INSTALL_PATHS[@]}"; do
  ensure_directory "$CODEX_PATH" "$install_path"
  merge_config "$install_path"

  while IFS= read -r -d '' source_dir; do
    relative_dir="${source_dir#"$CODEX_PATH"/}"
    ensure_directory "$source_dir" "$install_path/$relative_dir"
  done < <(find "$CODEX_PATH" -mindepth 1 -type d -print0)

  while IFS= read -r -d '' source_path; do
    [ -d "$source_path" ] && continue
    relative_file="${source_path#"$CODEX_PATH"/}"
    [ "$relative_file" = config.toml ] && continue
    target_path="$install_path/$relative_file"
    if [ -d "$target_path" ]; then
      printf 'Cannot replace directory with file link: %s\n' "$target_path" >&2
      exit 1
    fi
    ln -sfn "$(relative_path "$source_path" "${target_path%/*}")" "$target_path"
  done < <(find "$CODEX_PATH" \( -type f -o -type l \) -print0)
done
